<?xml version="1.0"?>
<robot name="wolf" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Wolf vehicle parameters (source: wolf_description/urdf/wolf.urdf) -->
  <xacro:property name="wheel_radius" value="0.32029"/>
  <xacro:property name="wheel_width" value="0.30"/>
  <xacro:property name="wheel_y" value="0.5957"/>
  <xacro:property name="wheel_x" value="0.6985"/>
  <xacro:property name="wheel_separation" value="1.1914"/>
  <xacro:property name="wheelbase" value="1.397"/>
  <xacro:property name="chassis_z" value="0.32"/>
  <xacro:property name="vehicle_mass" value="900"/>
  <xacro:property name="wheel_mass" value="80"/>

  <!-- ============================== -->
  <!-- base_link (ground projected)   -->
  <!-- ============================== -->
  <link name="base_link"/>

  <joint name="base_to_wolf_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="wolf_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="wolf_base_link">
    <inertial>
      <mass value="0.0001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="wolf_ground_to_chassis_center" type="fixed">
    <parent link="wolf_base_link"/>
    <child link="wolf_chassis_link"/>
    <origin xyz="0 0 ${chassis_z}" rpy="0 0 0"/>
  </joint>

  <!-- ============================== -->
  <!-- Chassis (physical body)        -->
  <!-- ============================== -->
  <link name="wolf_chassis_link">
    <visual>
      <geometry>
        <mesh filename="$(find base_nav2_stack)/meshes/Wolf/Wolf_Body.stl"/>
      </geometry>
      <material name="wolf_green">
        <color rgba="0.0 0.6 0.0 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.6 1.3 0.5"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${vehicle_mass}"/>
      <inertia ixx="213.3375" ixy="0" ixz="0" iyy="515.9775" iyz="0" izz="605.1"/>
    </inertial>
  </link>

  <!-- ============================== -->
  <!-- Left wheels (front/center/rear) -->
  <!-- ============================== -->
  <xacro:macro name="wolf_wheel" params="name x y">
    <joint name="wolf_${name}_wheel_joint" type="continuous">
      <parent link="wolf_chassis_link"/>
      <child link="wolf_${name}_wheel"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="400" velocity="50"/>
      <dynamics damping="1.0" friction="0.0"/>
    </joint>

    <link name="wolf_${name}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <mesh filename="$(find base_nav2_stack)/meshes/Wolf/Wolf_Wheel.stl"/>
        </geometry>
        <material name="wheel_black">
          <color rgba="0.3 0.3 0.3 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia ixx="2.396386" ixy="0" ixz="0" iyy="2.396386" iyz="0" izz="4.096"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:wolf_wheel name="left_front" x="${wheel_x}" y="${wheel_y}"/>
  <xacro:wolf_wheel name="left_center" x="0" y="${wheel_y}"/>
  <xacro:wolf_wheel name="left_rear" x="${-wheel_x}" y="${wheel_y}"/>
  <xacro:wolf_wheel name="right_front" x="${wheel_x}" y="${-wheel_y}"/>
  <xacro:wolf_wheel name="right_center" x="0" y="${-wheel_y}"/>
  <xacro:wolf_wheel name="right_rear" x="${-wheel_x}" y="${-wheel_y}"/>

  <!-- ============================== -->
  <!-- VectorNav IMU + GPS mounts     -->
  <!-- ============================== -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.02"/>
      </geometry>
      <material name="imu_darkgray">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="wolf_base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 1.245" rpy="0 0 0"/>
  </joint>

  <link name="gps_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.06 0.06 0.01"/>
      </geometry>
      <material name="gps_darkgray">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="wolf_base_link"/>
    <child link="gps_link"/>
    <origin xyz="0 0 1.26" rpy="0 0 0"/>
  </joint>

</robot>
